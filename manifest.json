{
  "manifest_version": 3,
  "name": "Tab Refresher",
  "version": "2.2.0",
  "description": "Refresca pestañas individualmente con intervalos por pestaña. Detección de foco, atajos y menú contextual.",
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "contextMenus"
  ],
  "commands": {
    "toggle-refresh": {
      "suggested_key": {
        "default": "Alt+R"
      },
      "description": "Alternar auto-refresco de la pestaña actual"
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "32": "icon.png",
      "48": "icon.png"
    },
    "default_title": "Tab Refresher"
  },
  "icons": {
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
